{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build MeanShift Example1 (C++23)",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++23",
                "-fmodules-ts",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/Dataset.cpp",
                "${workspaceFolder}/src/MeanShift.cpp",
                "${workspaceFolder}/examples/example1.cpp",
                "-o",
                "${workspaceFolder}/example1.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compiles the dummy data example using C++23."
        },
